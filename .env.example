# Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI in Google Cloud Console.
# In Codespaces this will look like: https://<your-codespace-name>-3000.app.github.dev/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Free key from https://aistudio.google.com
GEMINI_API_KEY=

# Any random string, used to sign the session cookie
SESSION_SECRET=change-me

# Where the file-backed session store lives (default: ./sessions.json)
SESSION_FILE=

# SameSite attribute for the session cookie: lax (default) | none | strict.
# Set to `none` when the client and the API are served from different sites
# (e.g. Codespaces forwards :5173 and :3000 as separate hosts) — otherwise the
# browser drops the cookie on cross-site fetches and every authed write 401s.
SESSION_COOKIE_SAMESITE=lax
